# What a remote build uploads from your working tree. CI checkouts carry none
# of this, so it only matters for a deploy run from your own machine; without
# it, node_modules and any local data ship to the builder.
.git
node_modules
dist
*.log
.env
.env.*
.envrc
mise.local.toml
*.pem
.claude
# raw scene-photo sources: not copied into the image (Dockerfile only COPYs
# server/, public/, README.md) and large — pointless to upload to the builder
tools/sources
